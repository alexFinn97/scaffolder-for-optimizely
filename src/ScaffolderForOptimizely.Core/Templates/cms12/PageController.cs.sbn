using EPiServer.Web.Mvc;
using Microsoft.AspNetCore.Mvc;

namespace {{ namespace }};

public class {{ class_name }} : PageController<{{ model_class }}>
{
    public IActionResult Index({{ model_class }} currentPage)
    {
{{~ if has_view_model ~}}
        var model = new {{ view_model_class }}(currentPage);

{{~ end ~}}
        return View({{ if view_path != "" }}"{{ view_path }}", {{ end }}{{ if has_view_model }}model{{ else }}currentPage{{ end }});
