<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>ScaffolderForOptimizely.Core</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Scriban ships inside the VSIX. -->
    <PackageReference Include="Scriban" Version="7.6.1" />
    <!-- Newtonsoft.Json and Roslyn are already loaded inside Visual Studio, so they must not be
         copied into the VSIX. Roslyn is compile-only here; consumers (tests) reference it themselves. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.0.1" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\**\*.sbn" LogicalName="Templates/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScaffolderForOptimizely.Core.Tests" />
    <InternalsVisibleTo Include="ScaffolderForOptimizely.Compile.Tests" />
  </ItemGroup>

</Project>
