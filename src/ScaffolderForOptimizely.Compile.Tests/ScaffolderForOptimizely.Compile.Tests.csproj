<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Generated code is compiled against the real Optimizely packages, so a template that
       doesn't compile fails the build. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="EPiServer.CMS.AspNetCore.Mvc" Version="12.24.3" />
    <PackageReference Include="EPiServer.CMS.Core" Version="12.24.3" />
    <!-- EPiServer.Shell: editor descriptors, selection factories, visitor group criteria. -->
    <PackageReference Include="EPiServer.CMS.UI.Core" Version="12.35.0" />
    <!-- Commerce 14: catalog content, promotions, payment, shipping and order services. -->
    <PackageReference Include="EPiServer.Commerce.Core" Version="14.48.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <!-- Transitive pins: EPiServer.CMS.Core 12 pulls in versions with known advisories, and its latest
       12.x doesn't move them. Each is the first fixed version in the same major. Remove a pin once
       the EPiServer packages resolve that version or later on their own. -->
  <ItemGroup>
    <!-- GHSA-7jgj-8wvc-jh57 (high), via Castle.Core > NETStandard.Library 1.6.1. -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <!-- GHSA-cmhx-cq75-c4mj (high), via Castle.Core > NETStandard.Library 1.6.1. -->
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    <!-- GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7 (moderate), via EPiServer.Framework and MimeKit. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <!-- GHSA-hh2w-p6rv-4g7w (high), via Castle.Windsor and Microsoft.Data.SqlClient > Azure.Identity.
         Resolved 7.0.3, which has no 7.x fix. Kept on the same version as ScaffolderForOptimizely.Core's
         reference, which flows in through the project reference: anything lower fails restore with
         NU1605. 11.0 and later don't support net8.0. -->
    <PackageReference Include="System.Text.Json" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScaffolderForOptimizely.Core\ScaffolderForOptimizely.Core.csproj" />
  </ItemGroup>

  <!-- The scenarios live in Core.Tests; compiling the same list here keeps both test projects in step. -->
  <ItemGroup>
    <Compile Include="..\ScaffolderForOptimizely.Core.Tests\Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
