      <Button guid="guidCommerceCmdSet" id="AddCatalogCategory" priority="0x0500" type="Button">
        <Parent guid="guidCommerceCmdSet" id="CommerceCatalogGroup" />
        <Icon guid="ImageCatalogGuid" id="FolderClosed" />
