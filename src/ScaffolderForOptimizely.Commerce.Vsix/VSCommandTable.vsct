  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <Include href="KnownImageIds.vsct" />

  <!--
    Solution Explorer > right-click a project or folder > Add > Optimizely Commerce > ...
    Buttons are hidden until the package confirms the project references Optimizely Commerce,
    and Visual Studio hides the submenu while all of them are hidden.
  -->
  <Commands package="guidCommercePackage">
    <Menus>
      <Menu guid="guidCommerceCmdSet" id="CommerceMenu" priority="0x0101" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_CTXT_PROJECT_ADD_ITEMS" />
        <Strings>
          <ButtonText>Optimizely Commerce</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidCommerceCmdSet" id="CommerceCatalogGroup" priority="0x0100">
        <Parent guid="guidCommerceCmdSet" id="CommerceMenu" />
      </Group>
      <Group guid="guidCommerceCmdSet" id="CommerceRenderingGroup" priority="0x0200">
        <Parent guid="guidCommerceCmdSet" id="CommerceMenu" />
      </Group>
      <Group guid="guidCommerceCmdSet" id="CommerceMarketingGroup" priority="0x0300">
        <Parent guid="guidCommerceCmdSet" id="CommerceMenu" />
      </Group>
      <Group guid="guidCommerceCmdSet" id="CommerceOrdersGroup" priority="0x0400">
        <Parent guid="guidCommerceCmdSet" id="CommerceMenu" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidCommerceCmdSet" id="AddProduct" priority="0x0100" type="Button">
        <Parent guid="guidCommerceCmdSet" id="CommerceCatalogGroup" />
        <Icon guid="ImageCatalogGuid" id="CatalogZone" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
