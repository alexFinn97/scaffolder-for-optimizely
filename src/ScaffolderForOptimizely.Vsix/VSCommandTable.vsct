  <!--
    Solution Explorer > right-click a project or folder > Add > Optimizely > ...
    Buttons are hidden until the package confirms the project references Optimizely.
  -->
  <Commands package="guidScaffolderPackage">
    <Menus>
      <Menu guid="guidScaffolderCmdSet" id="OptimizelyMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_CTXT_PROJECT_ADD_ITEMS" />
        <Strings>
          <ButtonText>Optimizely</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
