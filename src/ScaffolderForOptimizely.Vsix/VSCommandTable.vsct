  <!--
    Solution Explorer > right-click a project or folder > Add > Optimizely CMS (or Optimizely Commerce) > ...
    Buttons are hidden until the package confirms the project references Optimizely.
  -->
  <Commands package="guidScaffolderPackage">
    <Menus>
      <Menu guid="guidScaffolderCmdSet" id="OptimizelyMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_CTXT_PROJECT_ADD_ITEMS" />
        <Strings>
          <ButtonText>Optimizely CMS</ButtonText>
        </Strings>
      </Menu>
      <!-- Only Commerce projects: its commands are hidden elsewhere, and VS hides an empty submenu. -->
      <Menu guid="guidScaffolderCmdSet" id="CommerceMenu" priority="0x0101" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_CTXT_PROJECT_ADD_ITEMS" />
        <Strings>
          <ButtonText>Optimizely Commerce</ButtonText>
        </Strings>
      </Menu>
    </Menus>

