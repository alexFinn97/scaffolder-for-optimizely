<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Optimizely Block Component</Name>
    <Description>An AsyncBlockComponent that renders an Optimizely block type. For project-aware options use Add &gt; Optimizely.</Description>
    <TemplateID>ScaffolderForOptimizely.OptimizelyBlockComponent</TemplateID>
    <ProjectType>CSharp</ProjectType>
    <SortOrder>50</SortOrder>
    <DefaultName>TeaserBlockViewComponent.cs</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <AppendDefaultFileExtension>true</AppendDefaultFileExtension>
    <NumberOfParentCategoriesToRollUp>1</NumberOfParentCategoriesToRollUp>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.cs">BlockComponent.cs</ProjectItem>
  </TemplateContent>
</VSTemplate>
