<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Optimizely Page Controller</Name>
    <Description>A PageController for an Optimizely page type. For project-aware options use Add &gt; Optimizely.</Description>
    <TemplateID>ScaffolderForOptimizely.OptimizelyPageController</TemplateID>
    <ProjectType>CSharp</ProjectType>
    <SortOrder>40</SortOrder>
    <DefaultName>ArticlePageController.cs</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <AppendDefaultFileExtension>true</AppendDefaultFileExtension>
    <NumberOfParentCategoriesToRollUp>1</NumberOfParentCategoriesToRollUp>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.cs">PageController.cs</ProjectItem>
  </TemplateContent>
</VSTemplate>
