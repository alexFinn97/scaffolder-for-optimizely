<platform:DialogWindow
    x:Class="ScaffolderForOptimizely.UI.ScaffoldDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
    xmlns:local="clr-namespace:ScaffolderForOptimizely.UI"
    toolkit:Themes.UseVsTheme="True"
    Title="{Binding Title}"
    Width="1000"
    Height="640"
    MinWidth="760"
    MinHeight="480"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    ResizeMode="CanResizeWithGrip">

    <platform:DialogWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="Text">
            <StackPanel Margin="0,0,0,10" IsEnabled="{Binding IsEnabled}">
                <Label Content="{Binding Label}" Padding="0,0,0,3" />
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding Description}" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="EditableChoice">
            <StackPanel Margin="0,0,0,10" IsEnabled="{Binding IsEnabled}">
                <Label Content="{Binding Label}" Padding="0,0,0,3" />
                <ComboBox IsEditable="True" ItemsSource="{Binding ChoiceValues}"
                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding Description}" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FixedChoice">
            <StackPanel Margin="0,0,0,10" IsEnabled="{Binding IsEnabled}">
                <Label Content="{Binding Label}" Padding="0,0,0,3" />
                <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Value}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Bool">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding BoolValue}" IsEnabled="{Binding IsEnabled}" Margin="0,2,0,6" />
        </DataTemplate>

        <local:OptionTemplateSelector x:Key="OptionTemplateSelector" />
    </platform:DialogWindow.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Label Content="_Name" Target="{Binding ElementName=NameBox}" Padding="0,0,0,3" />
                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding NameHint}" Opacity="0.7" Margin="0,2,0,10" />

                <Label Content="Folder" Padding="0,0,0,3" />
                <TextBlock Text="{Binding TargetFolder}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <ItemsControl ItemsSource="{Binding Options}" ItemTemplateSelector="{StaticResource OptionTemplateSelector}" Focusable="False" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox ItemsSource="{Binding PreviewFiles}" SelectedItem="{Binding SelectedFile}"
                     DisplayMemberPath="Caption" MaxHeight="120" Margin="0,0,0,6" />

            <TextBox Grid.Row="1" Text="{Binding SelectedFile.Content, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True" TextWrapping="NoWrap" />

            <TextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </Grid>

        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding TemplateSourceNote}" Opacity="0.7" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ConfigNote}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="_Add" IsDefault="True" MinWidth="80" Margin="0,0,8,0"
                        IsEnabled="{Binding CanAdd}" Click="OnAddClick" />
                <Button Content="Cancel" IsCancel="True" MinWidth="80" />
            </StackPanel>
        </Grid>
    </Grid>
</platform:DialogWindow>
